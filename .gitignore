!gradle/wrapper/gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Log / crash files
*.log
hs_err_pid*
replay_pid*

# Kotlin
.kotlin/

# Android Studio / IntelliJ
*.iml
.idea/
.navigation/
captures/
.externalNativeBuild/
.cxx/

# NDK
obj/

# Keystore files (do not commit signing material)
*.jks
*.keystore

# Google Services (may contain keys)
google-services.json

# macOS
.DS_Store

# Windows
Thumbs.db
